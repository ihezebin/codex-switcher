{
  "name": "codex-switcher",
  "version": "0.1.3",
  "private": true,
  "description": "A desktop profile switcher for Codex configuration",
  "main": "dist-electron/main/index.js",
  "codexSwitcherUpdate": {
    "notes": "新增会话管理和用量统计功能，在设置中可查看使用。另外新增了多字体切换功能，和其他整体交互体验优化~",
    "releaseUrl": "https://github.com/ihezebin/codex-switcher/releases/tag/v0.1.3",
    "minimumVersion": "0.1.3",
    "proxyBaseUrl": "https://ghfast.top/",
    "downloads": {
      "darwin-arm64": "https://github.com/ihezebin/codex-switcher/releases/download/v0.1.3/Codex.Switcher-0.1.3-mac-arm64.dmg",
      "darwin-x64": "https://github.com/ihezebin/codex-switcher/releases/download/v0.1.3/Codex.Switcher-0.1.3-mac-x64.dmg",
      "win32-x64": "https://github.com/ihezebin/codex-switcher/releases/download/v0.1.3/Codex.Switcher-0.1.3-win-x64.exe",
      "linux-x64": ""
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "yarn build && electron-builder --win --x64 --publish never",
    "dist:mac": "yarn build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@chinese-fonts/xiaolai": "^3.0.0",
    "@free-fonts/zhuque-fangsong": "^1.0.0",
